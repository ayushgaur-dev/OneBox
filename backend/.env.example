# OneBox Backend Environment Variables
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env with real secrets to version control.

# Google Gemini API Key (Required for AI extraction and organization)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model selection (Optional, defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
